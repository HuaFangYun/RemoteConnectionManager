<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Only these feeds, so a build here or in CI never depends on feeds set up on one PC. -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- Microsoft.Terminal.Wpf and the ConPTY package are published here by the Windows Terminal team, not on nuget.org. -->
    <add key="TerminalDependencies" value="https://pkgs.dev.azure.com/shine-oss/terminal/_packaging/TerminalDependencies%40Local/nuget/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
