<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>RemoteConnectionManager.KeyVault</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Sign in through the Windows broker (WAM) so the PAW's Entra account is used without a browser. -->
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Identity.Broker" Version="1.7.0" />
    <!-- Subscriptions and vault discovery. -->
    <PackageReference Include="Azure.ResourceManager.KeyVault" Version="1.5.0" />
    <!-- Vault contents. -->
    <PackageReference Include="Azure.Security.KeyVault.Secrets" Version="4.12.0" />
    <PackageReference Include="Azure.Security.KeyVault.Keys" Version="4.10.2" />
    <PackageReference Include="Azure.Security.KeyVault.Certificates" Version="4.10.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Key Vault is also the "keyvault" credential plugin. -->
    <ProjectReference Include="..\RemoteConnectionManager.Plugins\RemoteConnectionManager.Plugins.csproj" />
  </ItemGroup>
</Project>
