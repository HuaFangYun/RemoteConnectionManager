<Project Sdk="Microsoft.NET.Sdk">
  <!-- 1Password credential source. Talks to the 1Password CLI (op.exe), which asks the 1Password
       desktop app to unlock (Windows Hello or the account password) when it needs to. No SDK and
       no service account token: the user's own unlocked app is the only way in. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>RemoteConnectionManager.Plugins.OnePassword</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\RemoteConnectionManager.Plugins\RemoteConnectionManager.Plugins.csproj" />
  </ItemGroup>
</Project>
