<UserControl x:Class="RemoteConnectionManager.App.Views.ServerStatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:RemoteConnectionManager.App.Views"
             xmlns:vm="clr-namespace:RemoteConnectionManager.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:ServerStatusTabViewModel}"
             Background="{StaticResource Chrome.Background}">
    <UserControl.Resources>
        <views:StringToVisibilityConverter x:Key="StringToVis" />
        <views:EmptyToVisibilityConverter x:Key="EmptyToVis" />
        <views:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisLocal" />
        <Style x:Key="BarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style x:Key="ColumnHeader" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="FontSize" Value="11" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Background="{StaticResource Chrome.Panel}" BorderBrush="{StaticResource Chrome.Border}" BorderThickness="0,0,0,1" Padding="8,6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding ReadText}" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Host}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,12,0" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Refresh (F5)" Command="{Binding RefreshCommand}" />
                    <Button Style="{StaticResource BarButton}" Content="Hardware stats" Command="{Binding LoadHardwareCommand}" Margin="6,0,6,0"
                            Visibility="{Binding ShowHardware, Converter={StaticResource InverseBoolToVisLocal}}" ToolTip="CPU, memory, disks and uptime" />
                    <Rectangle Width="1" Margin="6,2" Fill="{StaticResource Chrome.Border}" />
                    <Grid Width="220" Margin="4,0,10,0">
                        <TextBox x:Name="FilterBox" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" Height="24" Padding="24,2,6,2" FontSize="12" />
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE71C;" FontSize="12" HorizontalAlignment="Left" Margin="7,0,0,0" Foreground="{StaticResource Chrome.TextMuted}" IsHitTestVisible="False" />
                        <TextBlock Text="Search all services" Style="{StaticResource Muted}" FontSize="12" Margin="26,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Visibility="{Binding Text, ElementName=FilterBox, Converter={StaticResource EmptyToVis}}" />
                    </Grid>
                    <CheckBox Content="Show all services" IsChecked="{Binding ShowAll}" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Error bar -->
        <Border Grid.Row="1" Background="#3a1d1f" BorderBrush="{StaticResource Chrome.Danger}" BorderThickness="0,0,0,1" Padding="10,6"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="10" Padding="4" MinWidth="0" ToolTip="Dismiss" Command="{Binding DismissErrorCommand}" />
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE783;" HorizontalAlignment="Left" Foreground="{StaticResource Chrome.Danger}" Margin="0,0,8,0" />
                <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Services -->
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="12,10,12,6">
                    <TextBlock Text="{Binding SummaryText}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding WatchListText}" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding HiddenText}" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                               Visibility="{Binding HiddenText, Converter={StaticResource StringToVis}}" />
                    <TextBlock Text="{Binding UnmatchedText}" Foreground="{StaticResource Chrome.Warn}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                               Visibility="{Binding UnmatchedText, Converter={StaticResource StringToVis}}" />
                </StackPanel>
                <Border DockPanel.Dock="Top" Padding="10,5" BorderBrush="{StaticResource Chrome.Border}" BorderThickness="0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="160" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="Service" Style="{StaticResource ColumnHeader}" />
                        <TextBlock Grid.Column="2" Text="Name" Style="{StaticResource ColumnHeader}" />
                        <TextBlock Grid.Column="3" Text="State" Style="{StaticResource ColumnHeader}" />
                        <TextBlock Grid.Column="4" Text="Start" Style="{StaticResource ColumnHeader}" />
                        <TextBlock Grid.Column="5" Text="Why listed" Style="{StaticResource ColumnHeader}" />
                    </Grid>
                </Border>
                <Grid>
                    <ListBox ItemsSource="{Binding Rows}" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource ListRow}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ServiceRowViewModel}">
                                <Grid AutomationProperties.Name="{Binding DisplayName}" ToolTip="{Binding Account}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="160" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{StaticResource Chrome.TextMuted}" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                    <TextBlock Grid.Column="1" x:Name="DisplayText" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding Name}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="3" x:Name="StateText" Text="{Binding State}" />
                                    <TextBlock Grid.Column="4" Text="{Binding StartModeText}" Style="{StaticResource Muted}" />
                                    <TextBlock Grid.Column="5" Text="{Binding ReasonText}" Style="{StaticResource Muted}" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Chrome.Ok}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsWatched}" Value="True">
                                        <Setter TargetName="DisplayText" Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding NeedsAttention}" Value="True">
                                        <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Chrome.Danger}" />
                                        <Setter TargetName="StateText" Property="Foreground" Value="{StaticResource Chrome.Danger}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="Reading services..." Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding IsLoadingServices, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </DockPanel>

            <!-- Hardware -->
            <Border Grid.Column="1" Width="340" Background="{StaticResource Chrome.Panel}" BorderBrush="{StaticResource Chrome.Border}" BorderThickness="1,0,0,0"
                    Visibility="{Binding ShowHardware, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="14,10,8,6">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="10" Padding="4" MinWidth="0" ToolTip="Hide hardware stats" Command="{Binding HideHardwareCommand}" />
                        <StackPanel>
                            <TextBlock Text="Hardware" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding HardwareReadText}" Style="{StaticResource Muted}" FontSize="11" />
                        </StackPanel>
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="14,0,14,14">
                            <TextBlock Text="Reading hardware..." Style="{StaticResource Muted}" Margin="0,6"
                                       Visibility="{Binding IsLoadingHardware, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding HardwareError}" Foreground="{StaticResource Chrome.Danger}" TextWrapping="Wrap" Margin="0,6"
                                       Visibility="{Binding HardwareError, Converter={StaticResource StringToVis}}" />
                            <ItemsControl ItemsSource="{Binding HardwareRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:PropertyRow}">
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding Usage}" Margin="0,10,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:UsageRow}">
                                        <StackPanel Margin="0,5">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="11" />
                                                <TextBlock Text="{Binding Label}" />
                                            </DockPanel>
                                            <ProgressBar x:Name="Bar" Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="6" Margin="0,4,0,0" BorderThickness="0"
                                                         Background="{StaticResource Surface.Input}" Foreground="{StaticResource Chrome.Accent}" />
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsHigh}" Value="True">
                                                <Setter TargetName="Bar" Property="Foreground" Value="{StaticResource Chrome.Warn}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="{StaticResource Chrome.Panel}" BorderBrush="{StaticResource Chrome.Border}" BorderThickness="0,1,0,0" Padding="10,4">
            <TextBlock Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"
                       Text="Read only. Queried as your logged on account over WinRM, or DCOM when WinRM is not listening. Nothing on the host is changed." />
        </Border>
    </Grid>
</UserControl>
