<Window x:Class="RemoteConnectionManager.App.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:RemoteConnectionManager.App.Views"
        xmlns:vm="clr-namespace:RemoteConnectionManager.App.ViewModels"
        Title="RemoteConnectionManager" Height="900" Width="1500" MinHeight="500" MinWidth="900"
        Style="{StaticResource DarkWindow}"
        d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <views:BoolToFontWeightConverter x:Key="BoldWhenTrue" />
        <views:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <views:DoubleToGridLengthConverter x:Key="DoubleToGridLength" />
        <views:EmptyToVisibilityConverter x:Key="EmptyToVis" />
        <views:StringToVisibilityConverter x:Key="StringToVis" />

        <DataTemplate DataType="{x:Type vm:DashboardTabViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RdpSessionTabViewModel}">
            <views:RdpSessionView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TerminalSessionTabViewModel}">
            <views:TerminalSessionView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:KeyVaultTabViewModel}">
            <views:KeyVaultView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AzureBrowserTabViewModel}">
            <views:AzureBrowserView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:WebSessionTabViewModel}">
            <views:WebSessionView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ServerStatusTabViewModel}">
            <views:ServerStatusView />
        </DataTemplate>

        <Style x:Key="CommandBarButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Foreground" Value="{StaticResource Chrome.Text}" />
            <Setter Property="Margin" Value="1,0" />
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewRdpCommand}" />
        <KeyBinding Key="T" Modifiers="Control" Command="{Binding QuickTerminalCommand}" />
        <KeyBinding Key="K" Modifiers="Control+Shift" Command="{Binding OpenAzureBrowserCommand}" />
        <KeyBinding Key="F5" Command="{Binding ReloadCommand}" />
        <KeyBinding Key="B" Modifiers="Control" Command="{Binding ToggleNavigationCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <!-- ================= Command bar ================= -->
        <Border Grid.Row="0" Background="{StaticResource Chrome.Panel}" BorderBrush="{StaticResource Chrome.Border}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="6,0">
                    <Button Style="{StaticResource CommandBarButton}" Content="&#xE700;" ToolTip="Show or hide navigation (Ctrl+B)" Command="{Binding ToggleNavigationCommand}" />
                    <Rectangle Width="1" Margin="4,8" Fill="{StaticResource Chrome.Border}" />
                    <Button Style="{StaticResource CommandBarButton}" Content="&#xE768;" ToolTip="Connect" Command="{Binding ConnectCommand}" Foreground="{StaticResource Chrome.Ok}" />
                    <Button Style="{StaticResource CommandBarButton}" Content="&#xE756;" ToolTip="Open a PowerShell tab (Ctrl+T)" Command="{Binding QuickTerminalCommand}" Foreground="{StaticResource Icon.Terminal}" />
                    <Button Style="{StaticResource CommandBarButton}" Content="&#xE8D7;" ToolTip="Browse Azure Key Vaults (Ctrl+Shift+K)" Command="{Binding OpenAzureBrowserCommand}" Foreground="{StaticResource Icon.Vault}" />
                    <Button x:Name="NewButton" Style="{StaticResource CommandBarButton}" Content="&#xE710;" ToolTip="New entry" Click="DropDownButton_Click" Foreground="{StaticResource Chrome.AccentLight}">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="RDP connection (Ctrl+N)" Command="{Binding NewRdpCommand}" />
                                <MenuItem Header="Terminal" Command="{Binding NewTerminalCommand}" />
                                <MenuItem Header="SSH (switch, router, Linux)" Command="{Binding NewSshCommand}" />
                                <MenuItem Header="Telnet" Command="{Binding NewTelnetCommand}" />
                                <MenuItem Header="Website" Command="{Binding NewWebsiteCommand}" />
                                <MenuItem Header="Key Vault" Command="{Binding NewKeyVaultCommand}" />
                                <Separator />
                                <MenuItem Header="Folder" Command="{Binding NewFolderCommand}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Style="{StaticResource CommandBarButton}" Content="&#xE8C8;" ToolTip="Duplicate" Command="{Binding DuplicateCommand}" />
                    <Button Style="{StaticResource CommandBarButton}" Content="&#xE70F;" ToolTip="Edit" Command="{Binding EditCommand}" />
                    <Button Style="{StaticResource CommandBarButton}" Content="&#xE74D;" ToolTip="Delete" Command="{Binding DeleteCommand}" />
                    <Rectangle Width="1" Margin="4,8" Fill="{StaticResource Chrome.Border}" />
                    <Button Style="{StaticResource CommandBarButton}" Content="&#xE8B5;" ToolTip="Import connections" Click="DropDownButton_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="From Remote Desktop Manager (.rdm, .csv)" Command="{Binding ImportRdmCommand}" />
                                <MenuItem Header="From Royal TS (.rtsz)" Command="{Binding ImportRoyalTsCommand}" />
                                <MenuItem Header="From mRemoteNG (confCons.xml)" Command="{Binding ImportMRemoteNgCommand}" />
                                <Separator />
                                <MenuItem Header="Export to a connections file..." Command="{Binding ExportToFileCommand}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Style="{StaticResource CommandBarButton}" Content="&#xE72C;" ToolTip="Reload connections (F5)" Command="{Binding ReloadCommand}" />
                    <Button Style="{StaticResource CommandBarButton}" Content="&#xE716;" ToolTip="Users and groups (RCM admins)" Command="{Binding OpenAdminCommand}"
                            Visibility="{Binding ShowAdminButton, Converter={StaticResource BoolToVis}}" />
                    <Rectangle Width="1" Margin="4,8" Fill="{StaticResource Chrome.Border}" />
                    <Button Style="{StaticResource CommandBarButton}" Content="&#xE713;" ToolTip="Settings" Command="{Binding OpenSettingsCommand}" />
                    <Button Style="{StaticResource CommandBarButton}" Content="&#xE9F9;" ToolTip="Open log folder" Command="{Binding OpenLogFolderCommand}" />
                </StackPanel>

                <Grid Grid.Column="1" Width="280" Margin="0,0,10,0" VerticalAlignment="Center">
                    <TextBox x:Name="SearchBox" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" Padding="26,4,52,4" Height="26" />
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" HorizontalAlignment="Left" Margin="8,0,0,0" Foreground="{StaticResource Chrome.TextMuted}" IsHitTestVisible="False" />
                    <TextBlock Text="Search everywhere" Style="{StaticResource Muted}" Margin="28,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                               Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource EmptyToVis}}" />
                    <Border HorizontalAlignment="Right" Margin="0,0,6,0" Background="{StaticResource Surface.Control}" CornerRadius="3" Padding="5,1" IsHitTestVisible="False">
                        <TextBlock Text="Ctrl+K" FontSize="10" Style="{StaticResource Muted}" />
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- ================= Body ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44" />
                <ColumnDefinition x:Name="NavColumn" Width="{Binding NavigationWidth, Mode=TwoWay, Converter={StaticResource DoubleToGridLength}}" MinWidth="0" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!-- Icon rail -->
            <Border Grid.Column="0" Background="{StaticResource Chrome.Rail}" BorderBrush="{StaticResource Chrome.Border}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,6">
                        <Button Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="Settings" Command="{Binding OpenSettingsCommand}" Foreground="{StaticResource Chrome.TextMuted}" />
                    </StackPanel>
                    <ListBox x:Name="Rail" Background="Transparent" BorderThickness="0" SelectedIndex="0" ItemContainerStyle="{StaticResource RailItem}" SelectionChanged="Rail_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" Padding="0">
                        <ListBoxItem ToolTip="Navigation"><TextBlock Style="{StaticResource Glyph}" Text="&#xE8A4;" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" /></ListBoxItem>
                        <ListBoxItem ToolTip="Dashboard"><TextBlock Style="{StaticResource Glyph}" Text="&#xE80F;" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" /></ListBoxItem>
                        <ListBoxItem ToolTip="Favourites (filter)"><TextBlock Style="{StaticResource Glyph}" Text="&#xE734;" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" /></ListBoxItem>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Navigation panel -->
            <Border Grid.Column="1" Background="{StaticResource Chrome.Panel}" Visibility="{Binding NavigationVisible, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{StaticResource Chrome.PanelHeader}" Height="30" Padding="10,0">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="11" Padding="4" ToolTip="Hide navigation" Command="{Binding ToggleNavigationCommand}" Foreground="{StaticResource Chrome.TextMuted}" />
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8A4;" HorizontalAlignment="Left" Margin="0,0,8,0" Foreground="{StaticResource Chrome.AccentLight}" />
                            <TextBlock Style="{StaticResource PanelTitle}" Text="Navigation" />
                        </DockPanel>
                    </Border>

                    <!-- Data source line, like RDM's vault combo -->
                    <Border DockPanel.Dock="Top" Padding="10,6" BorderBrush="{StaticResource Chrome.Border}" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8A5;" HorizontalAlignment="Left" Margin="0,0,8,0" Foreground="{StaticResource Icon.Folder}" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding ConnectionsFileName}" ToolTip="{Binding ConnectionsFilePath}" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="StoreDetail" Text="{Binding StoreDetailText}" ToolTip="{Binding StoreDetailText}" FontSize="11" TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding StoreDetailText, Converter={StaticResource StringToVis}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StoreIsReadOnly}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Chrome.Warn}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <!-- Newer changes in the shared database; reloading is up to the person -->
                    <Border DockPanel.Dock="Top" Padding="10,6" BorderBrush="{StaticResource Chrome.Border}" BorderThickness="0,0,0,1"
                            Visibility="{Binding ChangesNotice, Converter={StaticResource StringToVis}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Reload" Command="{Binding ReloadCommand}" Style="{StaticResource AccentButton}"
                                    MinWidth="64" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="Reload connections (F5)" />
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE895;" Foreground="{StaticResource Chrome.Accent}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ChangesNotice}" ToolTip="{Binding ChangesNotice}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"
                                       AutomationProperties.LiveSetting="Polite" />
                        </DockPanel>
                    </Border>
                    <Border DockPanel.Dock="Top" Padding="12,4" BorderBrush="{StaticResource Chrome.Border}" BorderThickness="0,0,0,1">
                        <TextBlock Text="Name" Style="{StaticResource Muted}" FontSize="11" />
                    </Border>

                    <!-- Filter + count at the bottom -->
                    <Border DockPanel.Dock="Bottom" Padding="8,5" BorderBrush="{StaticResource Chrome.Border}" BorderThickness="0,1,0,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding EntryCountText}" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" />
                            <Grid>
                                <TextBox x:Name="FilterBox" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" Height="24" Padding="24,2,6,2" FontSize="12" />
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE71C;" FontSize="12" HorizontalAlignment="Left" Margin="7,0,0,0" Foreground="{StaticResource Chrome.TextMuted}" IsHitTestVisible="False" />
                                <TextBlock Text="Filter entries" Style="{StaticResource Muted}" FontSize="12" Margin="26,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                           Visibility="{Binding Text, ElementName=FilterBox, Converter={StaticResource EmptyToVis}}" />
                            </Grid>
                        </DockPanel>
                    </Border>

                    <TreeView x:Name="Tree" ItemsSource="{Binding RootNodes}" Padding="4,4,4,0"
                              SelectedItemChanged="Tree_SelectedItemChanged" PreviewMouseRightButtonDown="Tree_PreviewMouseRightButtonDown" MouseDoubleClick="Tree_MouseDoubleClick" KeyDown="Tree_KeyDown">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type vm:TreeNodeViewModel}" ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" ToolTip="{Binding Path}">
                                    <TextBlock Style="{StaticResource TypedGlyph}" Text="{Binding Glyph}" Margin="0,0,7,0" FontSize="13" />
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="{Binding HasOpenSession, Converter={StaticResource BoldWhenTrue}}" />
                                    <Ellipse Width="6" Height="6" Fill="{StaticResource Chrome.Ok}" Margin="7,0,0,0" VerticalAlignment="Center"
                                             Visibility="{Binding HasOpenSession, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                        <TreeView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Connect" Command="{Binding ConnectCommand}" />
                                <MenuItem Header="Open in browser" Command="{Binding OpenInBrowserCommand}"
                                          Visibility="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={StaticResource BoolToVis}}" />
                                <MenuItem Header="Open in a tab" Command="{Binding OpenInTabCommand}"
                                          Visibility="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={StaticResource BoolToVis}}" />
                                <MenuItem Header="Check services" Command="{Binding CheckServicesCommand}" />
                                <MenuItem Header="Hardware stats" Command="{Binding HardwareStatsCommand}" />
                                <Separator />
                                <MenuItem Header="New RDP connection" Command="{Binding NewRdpCommand}" />
                                <MenuItem Header="New terminal" Command="{Binding NewTerminalCommand}" />
                                <MenuItem Header="New SSH connection" Command="{Binding NewSshCommand}" />
                                <MenuItem Header="New telnet connection" Command="{Binding NewTelnetCommand}" />
                                <MenuItem Header="New website" Command="{Binding NewWebsiteCommand}" />
                                <MenuItem Header="New Key Vault" Command="{Binding NewKeyVaultCommand}" />
                                <MenuItem Header="New folder" Command="{Binding NewFolderCommand}" />
                                <Separator />
                                <MenuItem Header="Edit" Command="{Binding EditCommand}" />
                                <MenuItem Header="Duplicate" Command="{Binding DuplicateCommand}" />
                                <MenuItem Header="Delete" Command="{Binding DeleteCommand}" />
                                <Separator />
                                <MenuItem Header="My watched services..." Command="{Binding MyWatchedServicesCommand}" />
                                <MenuItem Header="Permissions..." Command="{Binding FolderPermissionsCommand}"
                                          Visibility="{Binding IsSqlStore, Converter={StaticResource BoolToVis}}" />
                            </ContextMenu>
                        </TreeView.ContextMenu>
                    </TreeView>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="2" Width="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Visibility="{Binding NavigationVisible, Converter={StaticResource BoolToVis}}" />

            <!-- Centre: tab strip + content -->
            <Grid Grid.Column="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Background="{StaticResource Tab.Strip}" BorderBrush="{StaticResource Chrome.Border}" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE894;" FontSize="12" ToolTip="Close all sessions"
                                Command="{Binding CloseAllSessionsCommand}" Foreground="{StaticResource Chrome.TextMuted}" />
                        <ListBox ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab, Mode=TwoWay}" Background="Transparent" BorderThickness="0"
                                 ItemContainerStyle="{StaticResource SessionTabItem}" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:TabViewModelBase}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource TypedGlyphOnAccent}" Text="{Binding Glyph}" Margin="0,0,7,0" FontSize="12" />
                                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                        <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="9" Padding="4,2" Margin="8,0,-4,0" MinWidth="0" ToolTip="Close"
                                                Visibility="{Binding CanClose, Converter={StaticResource BoolToVis}}"
                                                Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- All tab contents stay alive; only the selected one is visible. Keeps RDP HWNDs intact. -->
                <ItemsControl Grid.Row="1" ItemsSource="{Binding Tabs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Grid />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Visibility" Value="{Binding IsSelected, Converter={StaticResource BoolToVis}}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>
            </Grid>
        </Grid>

        <!-- ================= Status bar ================= -->
        <Border Grid.Row="2" Background="{StaticResource Chrome.Panel}" BorderBrush="{StaticResource Chrome.Border}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE77B;" FontSize="11" Margin="0,0,5,0" Foreground="{StaticResource Icon.User}" />
                    <TextBlock Text="{Binding UserText}" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" />
                    <Rectangle Width="1" Height="14" Fill="{StaticResource Chrome.Border}" Margin="8,0" />
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE753;" FontSize="11" Margin="0,0,5,0" Foreground="{StaticResource Icon.Azure}" />
                    <TextBlock Text="{Binding AzureAccountText}" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Cursor="Hand"
                               ToolTip="Open the Azure Key Vault browser to sign in or out" MouseLeftButtonUp="AzureAccount_Click" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Rectangle Width="1" Height="14" Fill="{StaticResource Chrome.Border}" Margin="0,0,8,0" />
                    <TextBlock Text="Connect" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <Grid Width="220">
                        <TextBox x:Name="QuickBox" Text="{Binding QuickConnectHost, UpdateSourceTrigger=PropertyChanged}" Height="20" FontSize="11" Padding="4,0" KeyDown="QuickBox_KeyDown" />
                        <TextBlock Text="Host or IP address" Style="{StaticResource Muted}" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Visibility="{Binding Text, ElementName=QuickBox, Converter={StaticResource EmptyToVis}}" />
                    </Grid>
                    <Button x:Name="QuickConnectButton" Style="{StaticResource IconButton}" Content="&#xE768;" FontSize="11" Padding="4,2" MinWidth="0" ToolTip="Quick connect (Enter)" Command="{Binding QuickConnectCommand}" Foreground="{StaticResource Chrome.Ok}" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding StatusText}" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="10,0" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="3" Text="{Binding VersionText}" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="10,0" />
            </Grid>
        </Border>
    </Grid>
</Window>
