<UserControl x:Class="RemoteConnectionManager.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:RemoteConnectionManager.App.Views"
             xmlns:vm="clr-namespace:RemoteConnectionManager.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:DashboardTabViewModel}"
             Background="{StaticResource Chrome.Background}">
    <UserControl.Resources>
        <views:StringToVisibilityConverter x:Key="StringToVis" />
        <views:NullToVisibilityConverter x:Key="NullToVis" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="{Binding Subheading}" Style="{StaticResource Muted}" FontSize="12" />
            <TextBlock Text="{Binding Heading}" Style="{StaticResource Heading}" Margin="0,2,0,8" />
            <views:MarkdownView Markdown="{Binding Description}" Margin="0,0,0,16" AutomationProperties.Name="Description"
                                Visibility="{Binding Description, Converter={StaticResource StringToVis}}" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <Button Style="{StaticResource AccentButton}" Command="{Binding ConnectCommand}" IsEnabled="{Binding CanConnect}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" Foreground="{StaticResource Chrome.AccentText}" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding ConnectLabel}" Foreground="{StaticResource Chrome.AccentText}" />
                    </StackPanel>
                </Button>
                <Button Content="Edit" Margin="8,0,0,0" Command="{Binding Shell.EditCommand}" Visibility="{Binding Node, Converter={StaticResource NullToVis}}" />
                <Button Margin="8,0,0,0" Command="{Binding CheckServicesCommand}" Visibility="{Binding CanCheckServer, Converter={StaticResource BoolToVis}}"
                        ToolTip="Service status on this host, read over WinRM or DCOM without signing in to it">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE9D9;" Margin="0,0,8,0" />
                        <TextBlock Text="Check services" />
                    </StackPanel>
                </Button>
                <Button Content="Hardware stats" Margin="8,0,0,0" Command="{Binding HardwareStatsCommand}" Visibility="{Binding CanCheckServer, Converter={StaticResource BoolToVis}}"
                        ToolTip="CPU, memory, disks and uptime, plus service status" />
                <Button Content="My watched services" Margin="8,0,0,0" Command="{Binding Shell.MyWatchedServicesCommand}" Visibility="{Binding ShowPersonal, Converter={StaticResource BoolToVis}}"
                        ToolTip="Services only you want Check services to list here" />
                <Button Content="Permissions" Margin="8,0,0,0" Command="{Binding Shell.FolderPermissionsCommand}" Visibility="{Binding ShowPermissions, Converter={StaticResource BoolToVis}}"
                        ToolTip="Which groups can see, edit or manage this folder (needs Manage)" />
            </StackPanel>

            <Border Background="{StaticResource Chrome.Panel}" BorderBrush="{StaticResource Chrome.Border}" BorderThickness="1" CornerRadius="4" Padding="16,10,8,12"
                    Margin="0,0,0,12" Visibility="{Binding ShowSessions, Converter={StaticResource BoolToVis}}"
                    AutomationProperties.Name="Signed in now">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE72C;" FontSize="12" Padding="4" MinWidth="0"
                                ToolTip="Check again who is signed in" Command="{Binding RefreshSessionsCommand}" />
                        <TextBlock Text="Signed in now" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SessionsStatus}" Margin="12,0,8,0" VerticalAlignment="Center" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SessionsFailed}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Chrome.Warn}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DockPanel>
                    <ProgressBar IsIndeterminate="True" Height="2" Margin="0,6,8,0"
                                 Visibility="{Binding IsCheckingSessions, Converter={StaticResource BoolToVis}}" />
                    <ItemsControl ItemsSource="{Binding Sessions}" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SessionRow}">
                                <Grid Margin="0,3" AutomationProperties.Name="{Binding Account}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="174" />
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource Chrome.Warn}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource Chrome.Ok}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Grid.Column="1" TextTrimming="CharacterEllipsis" ToolTip="{Binding Account}">
                                        <Run Text="{Binding Account, Mode=OneWay}" />
                                        <Run Text="{Binding YouSuffix, Mode=OneWay}" Foreground="{StaticResource Chrome.AccentLight}" />
                                    </TextBlock>
                                    <TextBlock Grid.Column="2" Text="{Binding State}" Style="{StaticResource Muted}" />
                                    <TextBlock Grid.Column="3" Text="{Binding Detail}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource Chrome.Panel}" BorderBrush="{StaticResource Chrome.Border}" BorderThickness="1" CornerRadius="4" Padding="16,12">
                <ItemsControl ItemsSource="{Binding Properties}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PropertyRow}">
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}" />
                                <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
