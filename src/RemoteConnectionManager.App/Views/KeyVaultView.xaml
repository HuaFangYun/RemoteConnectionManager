<UserControl x:Class="RemoteConnectionManager.App.Views.KeyVaultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:RemoteConnectionManager.App.Views"
             xmlns:vm="clr-namespace:RemoteConnectionManager.App.ViewModels"
             xmlns:kv="clr-namespace:RemoteConnectionManager.KeyVault;assembly=RemoteConnectionManager.KeyVault"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:KeyVaultTabViewModel}"
             Background="{StaticResource Chrome.Background}">
    <UserControl.Resources>
        <views:StringToVisibilityConverter x:Key="StringToVis" />
        <views:EmptyToVisibilityConverter x:Key="EmptyToVis" />
        <views:NullToVisibilityConverter x:Key="NullToVis" />
        <views:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisLocal" />
        <Style x:Key="BarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style x:Key="ColumnHeader" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="FontSize" Value="11" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Vault header and kind switcher -->
        <Border Background="{StaticResource Chrome.Panel}" BorderBrush="{StaticResource Chrome.Border}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0">
                    <TextBlock Text="{Binding VaultUriText}" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE8C8;" FontSize="11" Padding="4,2" MinWidth="0" Margin="4,0,0,0"
                            ToolTip="Copy the vault URI" Command="{Binding CopyVaultUriCommand}" Foreground="{StaticResource Chrome.TextMuted}" />
                </StackPanel>
                <ListBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding SelectedKind, Mode=TwoWay}" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource TabStripItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:VaultKindChoice}">
                            <StackPanel Orientation="Horizontal" AutomationProperties.Name="{Binding Title}">
                                <TextBlock Style="{StaticResource TypedGlyph}" Text="{Binding Glyph}" FontSize="12" Margin="0,0,7,0" />
                                <TextBlock Text="{Binding Title}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Toolbar -->
        <Border Grid.Row="1" Background="{StaticResource Chrome.Panel}" BorderBrush="{StaticResource Chrome.Border}" BorderThickness="0,0,0,1" Padding="8,6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding CountsText}" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" />
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource AccentButton}" Padding="10,3" Margin="0,0,6,0" Command="{Binding NewCommand}" ToolTip="{Binding NewLabel}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" FontSize="11" Foreground="{StaticResource Chrome.AccentText}" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding NewLabel}" Foreground="{StaticResource Chrome.AccentText}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BarButton}" Content="Import PFX" Command="{Binding ImportCertificateCommand}"
                            Visibility="{Binding IsCertificates, Converter={StaticResource BoolToVis}}" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Refresh" Command="{Binding RefreshCommand}" />
                    <Rectangle Width="1" Margin="6,2" Fill="{StaticResource Chrome.Border}" />
                    <Grid Width="220" Margin="4,0,10,0">
                        <TextBox x:Name="FilterBox" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" Height="24" Padding="24,2,6,2" FontSize="12" />
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE71C;" FontSize="12" HorizontalAlignment="Left" Margin="7,0,0,0" Foreground="{StaticResource Chrome.TextMuted}" IsHitTestVisible="False" />
                        <TextBlock Text="Filter by name, type or tag" Style="{StaticResource Muted}" FontSize="12" Margin="26,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Visibility="{Binding Text, ElementName=FilterBox, Converter={StaticResource EmptyToVis}}" />
                    </Grid>
                    <CheckBox Content="Expired or expiring within 30 days" IsChecked="{Binding ExpiringOnly}" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Error bar: in place, not a message box -->
        <Border Grid.Row="2" Background="#3a1d1f" BorderBrush="{StaticResource Chrome.Danger}" BorderThickness="0,0,0,1" Padding="10,6"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="10" Padding="4" MinWidth="0" ToolTip="Dismiss" Command="{Binding DismissErrorCommand}" />
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE783;" HorizontalAlignment="Left" Foreground="{StaticResource Chrome.Danger}" Margin="0,0,8,0" />
                <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- List and detail -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="400" MinWidth="260" />
            </Grid.ColumnDefinitions>

            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="10,5" BorderBrush="{StaticResource Chrome.Border}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Name" Style="{StaticResource ColumnHeader}" />
                        <TextBlock Grid.Column="1" Text="Status" Style="{StaticResource ColumnHeader}" />
                        <TextBlock Grid.Column="2" Text="Expires" Style="{StaticResource ColumnHeader}" />
                        <TextBlock Grid.Column="3" Text="Updated" Style="{StaticResource ColumnHeader}" />
                    </Grid>
                </Border>
                <Grid>
                    <ListBox x:Name="ItemList" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource ListRow}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:VaultItemRowViewModel}">
                                <Grid AutomationProperties.Name="{Binding Name}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="NameText" Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                    <TextBlock x:Name="StatusText" Grid.Column="1" Text="{Binding StatusText}" Style="{StaticResource Muted}" />
                                    <TextBlock x:Name="ExpiresText" Grid.Column="2" Text="{Binding ExpiresText}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" Text="{Binding UpdatedText}" Style="{StaticResource Muted}" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                        <Setter TargetName="NameText" Property="Foreground" Value="{StaticResource Chrome.TextMuted}" />
                                        <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource Chrome.Warn}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsExpiringSoon}" Value="True">
                                        <Setter TargetName="ExpiresText" Property="Foreground" Value="{StaticResource Chrome.Warn}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsExpired}" Value="True">
                                        <Setter TargetName="ExpiresText" Property="Foreground" Value="{StaticResource Chrome.Danger}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0"
                               Visibility="{Binding EmptyText, Converter={StaticResource StringToVis}}" IsHitTestVisible="False" />
                    <TextBlock Text="{Binding BusyText}" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" IsHitTestVisible="False" />
                </Grid>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{StaticResource Chrome.Border}" />

            <!-- Detail pane -->
            <Border Grid.Column="2" Background="{StaticResource Chrome.Panel}">
                <Grid>
                    <TextBlock Text="Select an item to see its details." Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0"
                               Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisLocal}}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="16,14">
                            <TextBlock Text="{Binding SelectedRow.Name}" Style="{StaticResource Heading}" FontSize="18" TextWrapping="Wrap" Margin="0,0,0,10" />

                            <!-- Secret actions -->
                            <WrapPanel Visibility="{Binding IsSecretSelected, Converter={StaticResource BoolToVis}}" Margin="0,0,0,4">
                                <Button Style="{StaticResource AccentButton}" Padding="10,3" Margin="0,0,6,6" Command="{Binding CopyValueCommand}" ToolTip="Copy the value. The clipboard clears itself after 30 seconds and the value stays out of clipboard history.">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8C8;" FontSize="11" Foreground="{StaticResource Chrome.AccentText}" Margin="0,0,6,0" />
                                        <TextBlock Text="Copy value" Foreground="{StaticResource Chrome.AccentText}" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource BarButton}" Margin="0,0,6,6" Command="{Binding ToggleValueCommand}">
                                    <Grid>
                                        <TextBlock Text="Show value" Visibility="{Binding IsValueShown, Converter={StaticResource InverseBoolToVisLocal}}" />
                                        <TextBlock Text="Hide value" Visibility="{Binding IsValueShown, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource BarButton}" Margin="0,0,6,6" Content="New version" Command="{Binding NewVersionCommand}" />
                            </WrapPanel>

                            <!-- Certificate actions -->
                            <WrapPanel Visibility="{Binding IsCertificateSelected, Converter={StaticResource BoolToVis}}" Margin="0,0,0,4">
                                <Button Style="{StaticResource BarButton}" Margin="0,0,6,6" Content="Download .cer" Command="{Binding DownloadCerCommand}" ToolTip="Public certificate only" />
                                <Button Style="{StaticResource BarButton}" Margin="0,0,6,6" Content="Download with private key" Command="{Binding DownloadWithPrivateKeyCommand}" ToolTip="PFX or PEM with the private key, no password" />
                            </WrapPanel>

                            <WrapPanel Margin="0,0,0,10">
                                <Button Style="{StaticResource BarButton}" Margin="0,0,6,6" Content="Properties" Command="{Binding EditPropertiesCommand}" ToolTip="Enable or disable, change expiry" />
                                <Button Style="{StaticResource BarButton}" Margin="0,0,6,6" Content="Copy name" Command="{Binding CopyNameCommand}" />
                                <Button Style="{StaticResource BarButton}" Margin="0,0,6,6" Content="Copy identifier" Command="{Binding CopyIdentifierCommand}" />
                                <Button Style="{StaticResource BarButton}" Margin="0,0,6,6" Content="Delete" Command="{Binding DeleteCommand}" Foreground="{StaticResource Chrome.Danger}" />
                            </WrapPanel>

                            <!-- Revealed value -->
                            <Border Visibility="{Binding IsValueShown, Converter={StaticResource BoolToVis}}" Background="{StaticResource Surface.Input}"
                                    BorderBrush="{StaticResource Chrome.Warn}" BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBox Text="{Binding SecretValue, Mode=OneWay}" Style="{StaticResource SelectableText}" FontFamily="{StaticResource Font.Mono}" FontSize="12" MaxHeight="200"
                                             VerticalScrollBarVisibility="Auto" />
                                    <TextBlock Text="Hides after 60 seconds or when you select something else." Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>

                            <ItemsControl ItemsSource="{Binding DetailRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:PropertyRow}">
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}" />
                                            <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" Style="{StaticResource SelectableText}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Loading details..." Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0"
                                       Visibility="{Binding DetailBusy, Converter={StaticResource BoolToVis}}" />

                            <TextBlock Text="Versions" FontWeight="SemiBold" Margin="0,16,0,6" />
                            <ItemsControl ItemsSource="{Binding Versions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type kv:VaultItemVersion}">
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding Version, Mode=OneWay}" Style="{StaticResource SelectableText}" FontFamily="{StaticResource Font.Mono}" FontSize="11"
                                                     Foreground="{StaticResource Chrome.TextMuted}" TextWrapping="NoWrap" />
                                            <TextBlock Grid.Column="1" Text="{Binding CreatedOn, StringFormat='{}{0:yyyy-MM-dd}'}" Style="{StaticResource Muted}" FontSize="11" Margin="8,0,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Status line -->
        <Border Grid.Row="4" Background="{StaticResource Chrome.Panel}" BorderBrush="{StaticResource Chrome.Border}" BorderThickness="0,1,0,0" Padding="10,4"
                Visibility="{Binding StatusMessage, Converter={StaticResource StringToVis}}">
            <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="{StaticResource Chrome.Ok}" TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</UserControl>
