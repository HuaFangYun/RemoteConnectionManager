<Window x:Class="RemoteConnectionManager.App.Views.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:RemoteConnectionManager.App.Views"
        xmlns:data="clr-namespace:RemoteConnectionManager.Data.SqlServer;assembly=RemoteConnectionManager.Data.SqlServer"
        Title="Users and groups" Width="980" Height="680" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource DarkWindow}">
    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.ColumnSpan="3" x:Name="IntroText" Style="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,12"
                   Text="Groups decide who sees which folders (set them on a folder with Permissions). People get into the database through the rcm_user role; they appear here the first time they open RCM, or add their login now. Changes save as you make them." />

        <!-- Groups -->
        <DockPanel Grid.Row="1" Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Text="Groups" FontWeight="SemiBold" Margin="0,0,0,6" />
            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <TextBlock Text="Name" Style="{StaticResource Muted}" FontSize="11" />
                <TextBox x:Name="GroupNameBox" Margin="0,2,0,6" AutomationProperties.Name="Group name" />
                <TextBlock Text="Description" Style="{StaticResource Muted}" FontSize="11" />
                <TextBox x:Name="GroupDescriptionBox" Margin="0,2,0,8" AutomationProperties.Name="Group description" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="New group" Click="NewGroup_Click" MinWidth="80" />
                    <Button Content="Save group" Click="SaveGroup_Click" MinWidth="80" Margin="6,0,0,0" Style="{StaticResource AccentButton}" />
                    <Button Content="Delete" Click="DeleteGroup_Click" MinWidth="64" Margin="6,0,0,0" />
                </StackPanel>
            </StackPanel>
            <Border BorderBrush="{StaticResource Chrome.Border}" BorderThickness="1" CornerRadius="3">
                <ListBox x:Name="GroupList" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource ListRow}"
                         SelectionChanged="GroupList_SelectionChanged" AutomationProperties.Name="Groups">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type data:RcmGroup}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding MemberCount, StringFormat={}{0} members}" Style="{StaticResource Muted}" FontSize="11" />
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                </DockPanel>
                                <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </DockPanel>

        <!-- Users -->
        <DockPanel Grid.Row="1" Grid.Column="2">
            <TextBlock DockPanel.Dock="Top" x:Name="UsersTitle" Text="Users" FontWeight="SemiBold" Margin="0,0,0,6" />
            <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Button x:Name="CancelEditButton" DockPanel.Dock="Right" Content="Cancel" Click="CancelEdit_Click" MinWidth="70" Margin="6,0,0,0" Visibility="Collapsed" />
                <Button x:Name="SaveUserButton" DockPanel.Dock="Right" Content="Add user" Click="SaveUser_Click" MinWidth="80" Margin="6,0,0,0" />
                <TextBox x:Name="NewDisplayNameBox" DockPanel.Dock="Right" Width="180" Margin="6,0,0,0" AutomationProperties.Name="User display name"
                         ToolTip="Display name (optional)" PreviewKeyDown="UserBox_PreviewKeyDown" />
                <TextBox x:Name="NewLoginBox" AutomationProperties.Name="User login" ToolTip="Login as SQL Server sees it: DOMAIN\name, or name@domain.com for Microsoft Entra"
                         PreviewKeyDown="UserBox_PreviewKeyDown" />
            </DockPanel>
            <TextBlock x:Name="UserHelpText" DockPanel.Dock="Bottom" Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="Add a login (DOMAIN\name or name@domain.com) and an optional display name, so you can put someone in groups before they first open RCM. To change someone's name or login, double-click them or use the pencil." />
            <Border BorderBrush="{StaticResource Chrome.Border}" BorderThickness="1" CornerRadius="3">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="10,5" TextElement.FontSize="11">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="56" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="MemberHeader" Text="In group" Style="{StaticResource Muted}" FontSize="11" />
                        <TextBlock Grid.Column="1" Text="Login and groups" Style="{StaticResource Muted}" FontSize="11" />
                        <TextBlock Grid.Column="2" Text="Admin" Style="{StaticResource Muted}" FontSize="11" />
                        <TextBlock Grid.Column="3" Text="Last seen" Style="{StaticResource Muted}" FontSize="11" />
                    </Grid>
                    <ListBox x:Name="UserList" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource ListRow}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Users"
                             MouseDoubleClick="UserList_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type views:UserRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsMember, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanTickMember}"
                                              VerticalAlignment="Center" AutomationProperties.Name="{Binding Login, StringFormat=In group: {0}}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Groups}" Style="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="2" IsChecked="{Binding IsAdmin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"
                                              AutomationProperties.Name="{Binding Login, StringFormat=Admin: {0}}" />
                                    <TextBlock Grid.Column="3" Text="{Binding LastSeenText}" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource IconButton}" Content="&#xE70F;" FontSize="11" Padding="4" Click="EditUser_Click" Tag="{Binding}"
                                                ToolTip="Change this user's display name or login" AutomationProperties.Name="{Binding Login, StringFormat=Edit {0}}" />
                                        <Button Style="{StaticResource IconButton}" Content="&#xE74D;" FontSize="11" Padding="4" Click="DeleteUser_Click" Tag="{Binding}"
                                                ToolTip="Remove this user from RCM" AutomationProperties.Name="{Binding Login, StringFormat=Remove {0}}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </DockPanel>

        <Expander Grid.Row="2" Grid.ColumnSpan="3" Header="Recent changes" Margin="0,12,0,0" Foreground="{StaticResource Chrome.Text}" Expanded="Changes_Expanded">
            <Border BorderBrush="{StaticResource Chrome.Border}" BorderThickness="1" CornerRadius="3" Margin="0,6,0,0" MaxHeight="180">
                <ListBox x:Name="ChangeList" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource ListRow}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type data:ChangeLogRow}">
                            <TextBlock FontSize="11">
                                <Run Text="{Binding ChangedUtc, StringFormat={}{0:yyyy-MM-dd HH:mm} UTC, Mode=OneWay}" Foreground="{StaticResource Chrome.TextMuted}" />
                                <Run Text="  " />
                                <Run Text="{Binding ChangedBy, Mode=OneWay}" />
                                <Run Text="{Binding Action, Mode=OneWay}" Foreground="{StaticResource Chrome.AccentLight}" />
                                <Run Text="{Binding TargetKind, Mode=OneWay}" />
                                <Run Text="{Binding TargetName, Mode=OneWay}" FontWeight="SemiBold" />
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Expander>

        <DockPanel Grid.Row="3" Grid.ColumnSpan="3" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Close" IsCancel="True" MinWidth="90" />
            <TextBlock x:Name="StatusText" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>
    </Grid>
</Window>
