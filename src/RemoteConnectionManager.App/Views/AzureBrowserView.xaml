<UserControl x:Class="RemoteConnectionManager.App.Views.AzureBrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:RemoteConnectionManager.App.Views"
             xmlns:vm="clr-namespace:RemoteConnectionManager.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:AzureBrowserTabViewModel}"
             Background="{StaticResource Chrome.Background}">
    <UserControl.Resources>
        <views:StringToVisibilityConverter x:Key="StringToVis" />
        <views:EmptyToVisibilityConverter x:Key="EmptyToVis" />
        <views:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisLocal" />
        <Style x:Key="BarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Account -->
        <Border Background="{StaticResource Chrome.Panel}" BorderBrush="{StaticResource Chrome.Border}" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource AccentButton}" Padding="12,3" Margin="0,0,6,0" Content="Sign in" Command="{Binding SignInCommand}"
                            Visibility="{Binding IsSignedIn, Converter={StaticResource InverseBoolToVisLocal}}"
                            ToolTip="Uses the account Windows is signed in with, and asks only if that does not work" />
                    <Button Style="{StaticResource BarButton}" Content="Use another account" Command="{Binding SignInAnotherCommand}" />
                    <Button Style="{StaticResource BarButton}" Content="Sign out" Command="{Binding SignOutCommand}" Margin="0"
                            Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE753;" HorizontalAlignment="Left" Margin="0,0,10,0" Foreground="{StaticResource Chrome.Accent}" />
                <TextBlock Text="{Binding AccountText}" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- Toolbar -->
        <Border Grid.Row="1" Background="{StaticResource Chrome.Panel}" BorderBrush="{StaticResource Chrome.Border}" BorderThickness="0,0,0,1" Padding="8,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="Open by name" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <Grid Width="240">
                        <TextBox x:Name="NameBox" Text="{Binding OpenByName, UpdateSourceTrigger=PropertyChanged}" Height="24" Padding="6,2" FontSize="12" KeyDown="NameBox_KeyDown"
                                 ToolTip="Works without Azure Resource Manager access, for vaults where you only have a data role" />
                        <TextBlock Text="kv-name or https://kv-name.vault.azure.net" Style="{StaticResource Muted}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Visibility="{Binding Text, ElementName=NameBox, Converter={StaticResource EmptyToVis}}" />
                    </Grid>
                    <Button Style="{StaticResource BarButton}" Content="Open" Command="{Binding OpenNamedCommand}" Margin="6,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource AccentButton}" Padding="10,3" Margin="0,0,6,0" Content="Open vault" Command="{Binding OpenSelectedCommand}" />
                    <Button Style="{StaticResource BarButton}" Content="Pin to tree" Command="{Binding PinSelectedCommand}"
                            ToolTip="Adds the vault as a (KV) entry in the folder selected in the navigation tree" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Refresh" Command="{Binding RefreshCommand}" />
                    <Rectangle Width="1" Margin="6,2" Fill="{StaticResource Chrome.Border}" />
                    <Grid Width="220" Margin="4,0,0,0">
                        <TextBox x:Name="FilterBox" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" Height="24" Padding="24,2,6,2" FontSize="12" />
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE71C;" FontSize="12" HorizontalAlignment="Left" Margin="7,0,0,0" Foreground="{StaticResource Chrome.TextMuted}" IsHitTestVisible="False" />
                        <TextBlock Text="Filter vaults" Style="{StaticResource Muted}" FontSize="12" Margin="26,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Visibility="{Binding Text, ElementName=FilterBox, Converter={StaticResource EmptyToVis}}" />
                    </Grid>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Error bar -->
        <Border Grid.Row="2" Background="#3a1d1f" BorderBrush="{StaticResource Chrome.Danger}" BorderThickness="0,0,0,1" Padding="10,6"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="10" Padding="4" MinWidth="0" ToolTip="Dismiss" Command="{Binding DismissErrorCommand}" />
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE783;" HorizontalAlignment="Left" Foreground="{StaticResource Chrome.Danger}" Margin="0,0,8,0" />
                <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- Subscriptions > resource groups > vaults -->
        <TreeView Grid.Row="3" x:Name="Tree" ItemsSource="{Binding Roots}" Padding="8,6" SelectedItemChanged="Tree_SelectedItemChanged" MouseDoubleClick="Tree_MouseDoubleClick">
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate DataType="{x:Type vm:AzureNodeViewModel}" ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TypedGlyph}" Text="{Binding Glyph}" Margin="0,0,7,0" FontSize="13" />
                        <TextBlock x:Name="Label" Text="{Binding DisplayName}" />
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <HierarchicalDataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Kind}" Value="Message">
                            <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Chrome.Warn}" />
                        </DataTrigger>
                    </HierarchicalDataTemplate.Triggers>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
        <TextBlock Grid.Row="3" Text="{Binding BusyText}" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0"
                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" IsHitTestVisible="False" />

        <Border Grid.Row="4" Background="{StaticResource Chrome.Panel}" BorderBrush="{StaticResource Chrome.Border}" BorderThickness="0,1,0,0" Padding="10,4">
            <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</UserControl>
