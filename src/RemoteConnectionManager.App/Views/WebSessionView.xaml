<UserControl x:Class="RemoteConnectionManager.App.Views.WebSessionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RemoteConnectionManager.App.ViewModels"
             xmlns:views="clr-namespace:RemoteConnectionManager.App.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:WebSessionTabViewModel}"
             Background="{StaticResource Surface.Session}"
             DataContextChanged="OnDataContextChanged">
    <UserControl.Resources>
        <views:StringToVisibilityConverter x:Key="StringToVis" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar, same shape as the terminal and RDP ones -->
        <Border Background="{StaticResource Chrome.Panel}" BorderBrush="{StaticResource Chrome.Border}" BorderThickness="0,0,0,1" Padding="4,2">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Style="{StaticResource IconButton}" Content="&#xE72B;" ToolTip="Back" Command="{Binding BackCommand}" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE72A;" ToolTip="Forward" Command="{Binding ForwardCommand}" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Reload" Command="{Binding ReloadCommand}" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE80F;" ToolTip="Back to the entry's address" Command="{Binding HomeCommand}" />
                    <Rectangle Width="1" Margin="4,6" Fill="{StaticResource Chrome.Border}" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="8,0" MaxWidth="260" TextTrimming="CharacterEllipsis" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE8C8;" ToolTip="Copy the address" Command="{Binding CopyAddressCommand}" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE8A7;" ToolTip="Open in the default browser" Command="{Binding OpenInBrowserCommand}" Foreground="{StaticResource Icon.Website}" />
                </StackPanel>
                <TextBox Text="{Binding Address, Mode=OneWay}" IsReadOnly="True" VerticalAlignment="Center" Margin="4,0" FontSize="12"
                         AutomationProperties.Name="Address" BorderThickness="0" Background="Transparent" />
            </DockPanel>
        </Border>

        <!-- Notices sit above the page, never over it (WebView2 is an HWND: airspace) -->
        <StackPanel Grid.Row="1">
            <Border Background="{StaticResource Chrome.PanelHeader}" BorderBrush="{StaticResource Chrome.Border}" BorderThickness="0,0,0,1" Padding="10,6"
                    Visibility="{Binding CertificateMessage, Converter={StaticResource StringToVis}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Continue in this tab" Padding="12,3" Command="{Binding ContinueOnceCommand}"
                                ToolTip="Trust this host's certificate for this tab only, until it is closed" />
                        <Button Content="Open in browser" Padding="12,3" Margin="8,0,0,0" Command="{Binding OpenInBrowserCommand}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE7BA;" Foreground="{StaticResource Chrome.Warn}" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding CertificateMessage}" VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>
            </Border>
            <Border Background="{StaticResource Chrome.PanelHeader}" BorderBrush="{StaticResource Chrome.Border}" BorderThickness="0,0,0,1" Padding="10,6"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Open in browser" Padding="12,3" Command="{Binding OpenInBrowserCommand}" />
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE783;" Foreground="{StaticResource Chrome.Danger}" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding ErrorMessage}" VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>
            </Border>
        </StackPanel>

        <ContentControl Grid.Row="2" x:Name="HostSlot" Focusable="False" />
    </Grid>
</UserControl>
