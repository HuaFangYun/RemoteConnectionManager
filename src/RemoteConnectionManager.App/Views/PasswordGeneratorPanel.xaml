<UserControl x:Class="RemoteConnectionManager.App.Views.PasswordGeneratorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RemoteConnectionManager.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:PasswordGeneratorViewModel}"
             FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" Foreground="{StaticResource Chrome.Text}"
             UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <UserControl.Resources>
        <Style x:Key="RowLabel" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,7" />
        </Style>
    </UserControl.Resources>

    <!-- Margin leaves room for the shadow inside the transparent popup -->
    <Border Margin="8" Width="320" Background="{StaticResource Chrome.Panel}" BorderBrush="{StaticResource Surface.InputBorder}" BorderThickness="1"
            CornerRadius="6" Padding="14,12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.5" Color="Black" />
        </Border.Effect>
        <StackPanel>
            <Grid Margin="0,0,0,12">
                <Button Content="Cancel" HorizontalAlignment="Left" MinWidth="70" Click="Cancel_Click" />
                <Button Style="{StaticResource IconButton}" Content="&#xE72C;" HorizontalAlignment="Center" ToolTip="Generate another (F5)"
                        AutomationProperties.Name="Generate another" Command="{Binding RegenerateCommand}" Foreground="{StaticResource Chrome.Text}" />
                <Button x:Name="ActionButton" Content="{Binding ActionLabel}" Style="{StaticResource AccentButton}" HorizontalAlignment="Right" MinWidth="70"
                        Padding="14,5" Click="Action_Click" />
            </Grid>

            <!-- The value, digits and symbols coloured so look alikes are easier to tell apart -->
            <Border Background="{StaticResource Surface.Input}" BorderBrush="{StaticResource Surface.InputBorder}" BorderThickness="1" CornerRadius="4" Padding="10,9">
                <TextBlock x:Name="Preview" FontFamily="{StaticResource Font.Mono}" FontSize="14" TextWrapping="Wrap" MinHeight="20"
                           AutomationProperties.Name="Generated password" />
            </Border>

            <!-- Strength bar -->
            <Grid Margin="0,8,0,2" Height="3" ToolTip="{Binding StrengthText}">
                <Border Background="{StaticResource Surface.ControlHover}" CornerRadius="1.5" />
                <Border CornerRadius="1.5" RenderTransformOrigin="0,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform ScaleX="{Binding StrengthFraction}" />
                    </Border.RenderTransform>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource Chrome.Ok}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StrengthLevel}" Value="Weak">
                                    <Setter Property="Background" Value="{StaticResource Chrome.Danger}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StrengthLevel}" Value="Fair">
                                    <Setter Property="Background" Value="{StaticResource Chrome.Warn}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
            </Grid>
            <TextBlock Text="{Binding StrengthText}" Style="{StaticResource Muted}" FontSize="11" Margin="0,0,0,6" />

            <Grid Style="{StaticResource Row}">
                <TextBlock Style="{StaticResource RowLabel}" Text="Type" />
                <ComboBox HorizontalAlignment="Right" MinWidth="170" ItemsSource="{Binding Kinds}" SelectedItem="{Binding SelectedKind}"
                          AutomationProperties.Name="Password type" />
            </Grid>

            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="86" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource RowLabel}" Text="{Binding LengthLabel}" />
                <Slider Grid.Column="1" VerticalAlignment="Center" Minimum="{Binding LengthMin}" Maximum="{Binding LengthMax}"
                        Value="{Binding Length}" IsSnapToTickEnabled="True" TickFrequency="1" SmallChange="1" LargeChange="4"
                        AutomationProperties.Name="{Binding LengthLabel}" />
                <TextBox Grid.Column="2" Width="52" Margin="10,0,0,0" HorizontalContentAlignment="Center" Text="{Binding Length}"
                         AutomationProperties.Name="{Binding LengthLabel}" KeyDown="LengthBox_KeyDown" />
            </Grid>

            <!-- Random -->
            <StackPanel Visibility="{Binding IsRandom, Converter={StaticResource BoolToVis}}">
                <Grid Style="{StaticResource Row}">
                    <TextBlock Style="{StaticResource RowLabel}" Text="Numbers" />
                    <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" IsChecked="{Binding Numbers}" AutomationProperties.Name="Numbers" />
                </Grid>
                <Grid Style="{StaticResource Row}">
                    <TextBlock Style="{StaticResource RowLabel}" Text="Symbols" />
                    <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" IsChecked="{Binding Symbols}" AutomationProperties.Name="Symbols" />
                </Grid>
            </StackPanel>

            <!-- Memorable -->
            <StackPanel Visibility="{Binding IsMemorable, Converter={StaticResource BoolToVis}}">
                <Grid Style="{StaticResource Row}">
                    <TextBlock Style="{StaticResource RowLabel}" Text="Separator" />
                    <ComboBox HorizontalAlignment="Right" MinWidth="170" ItemsSource="{Binding Separators}" SelectedItem="{Binding Separator}"
                              AutomationProperties.Name="Separator" />
                </Grid>
                <Grid Style="{StaticResource Row}">
                    <TextBlock Style="{StaticResource RowLabel}" Text="Capitalise" />
                    <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" IsChecked="{Binding Capitalise}" AutomationProperties.Name="Capitalise" />
                </Grid>
                <Grid Style="{StaticResource Row}">
                    <TextBlock Style="{StaticResource RowLabel}" Text="Add a number" />
                    <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" IsChecked="{Binding AddNumber}" AutomationProperties.Name="Add a number" />
                </Grid>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
