<UserControl x:Class="RemoteConnectionManager.App.Views.TerminalSessionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RemoteConnectionManager.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:TerminalSessionTabViewModel}"
             Background="{StaticResource Surface.Session}"
             DataContextChanged="OnDataContextChanged">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Session toolbar, same shape as the RDP one -->
        <Border Background="{StaticResource Chrome.Panel}" BorderBrush="{StaticResource Chrome.Border}" BorderThickness="0,0,0,1" Padding="4,2">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding StatusMessage}" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="8,0" />
                <!-- Session log: red dot while this tab is logged; click to open the file -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Command="{Binding OpenLogCommand}" ToolTip="{Binding LogToolTip}" Padding="6,2" Margin="0,0,2,0"
                            Background="Transparent" BorderThickness="0" Cursor="Hand" AutomationProperties.Name="Open session log"
                            Visibility="{Binding IsLogging, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource Chrome.Danger}" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBlock Text="Log" FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Content="&#xE838;" FontSize="12" ToolTip="Open the session log folder" Command="{Binding OpenLogFolderCommand}"
                            Foreground="{StaticResource Chrome.TextMuted}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource IconButton}" Content="&#xE8C8;" ToolTip="Copy selection (Ctrl+Shift+C, or Ctrl+C with a selection)" Command="{Binding CopyCommand}" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE77F;" ToolTip="Paste (Ctrl+V or Shift+Insert)" Command="{Binding PasteCommand}" />
                    <Rectangle Width="1" Margin="4,6" Fill="{StaticResource Chrome.Border}" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE77B;" ToolTip="Send user name: types the entry's user name and presses Enter"
                            Command="{Binding SendUserNameCommand}" Visibility="{Binding ShowSendUserName, Converter={StaticResource BoolToVis}}" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE8D7;" ToolTip="{Binding SendPasswordToolTip}" Foreground="{StaticResource Icon.Vault}"
                            Command="{Binding SendPasswordCommand}" Visibility="{Binding HasCredential, Converter={StaticResource BoolToVis}}" />
                    <Rectangle Width="1" Margin="4,6" Fill="{StaticResource Chrome.Border}"
                               Visibility="{Binding HasCredential, Converter={StaticResource BoolToVis}}" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Restart or reconnect" Command="{Binding RestartCommand}" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE8C8;" FontSize="12" ToolTip="Copy the command line this tab runs" Command="{Binding CopyCommandLineCommand}" Foreground="{StaticResource Chrome.TextMuted}" />
                    <Rectangle Width="1" Margin="4,6" Fill="{StaticResource Chrome.Border}" />
                    <TextBlock Text="{Binding ShellText}" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0" />
                    <TextBlock Text="{Binding WorkingDirectoryText}" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Ended notice sits above the renderer rather than over it (airspace), so the last output stays readable -->
        <Border Grid.Row="1" Background="{StaticResource Chrome.PanelHeader}" BorderBrush="{StaticResource Chrome.Border}" BorderThickness="0,0,0,1" Padding="10,6"
                Visibility="{Binding ShowEndedBar, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource AccentButton}" Content="Restart" Padding="12,3" Command="{Binding RestartCommand}" ToolTip="Start the shell again, or reconnect" />
                    <Button Content="Close tab" Padding="12,3" Margin="8,0,0,0"
                            Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                </StackPanel>
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE7BA;" HorizontalAlignment="Left" Foreground="{StaticResource Chrome.Warn}" Margin="0,0,8,0" />
                <TextBlock Text="{Binding EndedMessage}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <Border Grid.Row="2" x:Name="HostBorder" BorderThickness="2" BorderBrush="Transparent" Background="{StaticResource Surface.Session}">
            <ContentControl x:Name="HostSlot" Focusable="False" />
        </Border>
    </Grid>
</UserControl>
