<UserControl x:Class="RemoteConnectionManager.App.Views.RdpSessionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:RemoteConnectionManager.App.Views"
             xmlns:vm="clr-namespace:RemoteConnectionManager.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:RdpSessionTabViewModel}"
             Background="{StaticResource Surface.Session}"
             DataContextChanged="OnDataContextChanged" Loaded="OnLoaded">
    <UserControl.Resources>
        <views:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Session toolbar. Hidden in full screen, where the bar at the top of the display takes over. -->
        <Border x:Name="Toolbar" Background="{StaticResource Chrome.Panel}" BorderBrush="{StaticResource Chrome.Border}" BorderThickness="0,0,0,1" Padding="4,2">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding StatusMessage}" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="8,0" />
                <StackPanel Orientation="Horizontal">
                    <ToggleButton Style="{StaticResource ToggleIconButton}" Content="&#xE765;" ToolTip="Keyboard pass through: Windows key and Alt+Tab go to the remote session when on"
                                  IsChecked="{Binding KeyboardPassThrough, Mode=OneWay}" Command="{Binding ToggleKeyboardCommand}" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE9A6;" ToolTip="Fit session to window now" Command="{Binding FitCommand}" />
                    <Rectangle Width="1" Margin="4,6" Fill="{StaticResource Chrome.Border}" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE740;" ToolTip="Full screen (click to choose the display)" Click="FullScreen_Click" />
                    <Button x:Name="DetachButton" Style="{StaticResource IconButton}" Content="&#xE8A7;" ToolTip="Open in its own window" Command="{Binding DetachCommand}" />
                    <Button x:Name="DockButton" Style="{StaticResource IconButton}" Content="&#xE73F;" ToolTip="Put back in its tab" Command="{Binding DockCommand}" />
                    <Rectangle Width="1" Margin="4,6" Fill="{StaticResource Chrome.Border}" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Reconnect" Command="{Binding ReconnectCommand}" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" ToolTip="Disconnect" Command="{Binding DisconnectCommand}" Foreground="{StaticResource Chrome.Danger}" />
                    <Rectangle Width="1" Margin="4,6" Fill="{StaticResource Chrome.Border}" />
                    <TextBlock Text="{Binding TargetText}" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="6,0" ToolTip="{Binding SignInText}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Session surface. Panels replace the host rather than covering it (airspace). -->
        <Border Grid.Row="1" x:Name="HostBorder" BorderThickness="2" BorderBrush="Transparent" Background="{StaticResource Surface.Session}">
            <Grid>
                <WindowsFormsHost x:Name="Host" Background="Black" />

                <!-- Connecting problems, credential errors and disconnects -->
                <Border x:Name="OverlayPanel" Background="{StaticResource Chrome.Background}" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE7F4;" FontSize="40" Foreground="{StaticResource Chrome.TextMuted}" Margin="0,0,0,12" />
                        <TextBlock Text="{Binding OverlayTitle}" Style="{StaticResource Heading}" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding TargetText}" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding OverlayDetail}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,14,0,20" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                    Visibility="{Binding IsResolvingCredential, Converter={StaticResource InverseBoolToVis}}">
                            <Button Style="{StaticResource AccentButton}" Content="Reconnect" Command="{Binding ReconnectCommand}" />
                            <Button Content="Close tab" Margin="8,0,0,0" Command="{Binding CloseCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Shown in the tab while the session lives in its own window -->
                <Border x:Name="DetachedPanel" Background="{StaticResource Chrome.Background}" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8A7;" FontSize="40" Foreground="{StaticResource Chrome.TextMuted}" Margin="0,0,0,12" />
                        <TextBlock Text="{Binding PlacementText}" Style="{StaticResource Heading}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,6,0,20" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Style="{StaticResource AccentButton}" Content="Put back in this tab" Command="{Binding DockCommand}" />
                            <Button Content="Show window" Margin="8,0,0,0" Command="{Binding ShowWindowCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
