<Window x:Class="RemoteConnectionManager.App.Views.FolderPermissionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:RemoteConnectionManager.App.Views"
        Title="Folder permissions" Width="560" SizeToContent="Height" MaxHeight="760"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Style="{StaticResource DarkWindow}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,16">
            <TextBlock x:Name="TitleText" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,12" FontSize="12"
                       Text="View: see and connect. Edit: add, change and delete entries and folders inside. Manage: Edit, plus change these permissions and move the folder. Folders below inherit these unless they opt out. RCM admins see everything." />

            <CheckBox x:Name="BreakBox" Content="Do not inherit permissions from the folders above" Checked="Break_Changed" Unchecked="Break_Changed" />

            <StackPanel x:Name="InheritedPanel" Margin="0,12,0,0">
                <TextBlock Text="Inherited" Style="{StaticResource Muted}" FontSize="11" />
                <Border x:Name="InheritedBorder" BorderBrush="{StaticResource Chrome.Border}" BorderThickness="1" CornerRadius="3" Margin="0,4,0,0">
                    <ItemsControl x:Name="InheritedList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="10,5">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding FromFolder, StringFormat=from {0}}" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Level}" Width="80" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding GroupName}" VerticalAlignment="Center" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                <TextBlock x:Name="NoInheritedText" Text="Nothing is inherited." Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0" />
            </StackPanel>

            <TextBlock Text="Set on this folder" Style="{StaticResource Muted}" FontSize="11" Margin="0,14,0,0" />
            <Border x:Name="OwnBorder" BorderBrush="{StaticResource Chrome.Border}" BorderThickness="1" CornerRadius="3" Margin="0,4,0,0">
                <ItemsControl x:Name="OwnList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type views:PermissionRow}">
                            <DockPanel Margin="10,4">
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="10" Padding="4" ToolTip="Remove"
                                        AutomationProperties.Name="{Binding GroupName, StringFormat=Remove {0}}" Click="Remove_Click" Tag="{Binding}" />
                                <ComboBox DockPanel.Dock="Right" Width="110" Margin="8,0" ItemsSource="{x:Static views:PermissionRow.Levels}" SelectedItem="{Binding Level}"
                                          AutomationProperties.Name="{Binding GroupName, StringFormat=Level for {0}}" />
                                <TextBlock Text="{Binding GroupName}" VerticalAlignment="Center" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
            <TextBlock x:Name="NoOwnText" Text="No permissions set here." Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0" />

            <DockPanel Margin="0,10,0,0">
                <Button DockPanel.Dock="Right" Content="Add" MinWidth="70" Margin="8,0,0,0" Click="Add_Click" />
                <ComboBox x:Name="AddLevelBox" DockPanel.Dock="Right" Width="110" Margin="8,0,0,0" ItemsSource="{x:Static views:PermissionRow.Levels}" AutomationProperties.Name="Level to add" />
                <ComboBox x:Name="GroupBox" DisplayMemberPath="Name" AutomationProperties.Name="Group to add" />
            </DockPanel>
            <TextBlock x:Name="NoGroupsText" Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="There are no groups yet. An RCM admin creates them in Users and groups." />

            <TextBlock x:Name="WarningText" Foreground="{StaticResource Chrome.Warn}" TextWrapping="Wrap" Margin="0,12,0,0" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Cancel" IsCancel="True" MinWidth="90" />
                <Button Content="Save" IsDefault="True" Style="{StaticResource AccentButton}" MinWidth="90" Margin="8,0,0,0" Click="Save_Click" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
