<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <MsRdpExComInterop>Legacy</MsRdpExComInterop>
    <RootNamespace>RemoteConnectionManager.App</RootNamespace>
    <AssemblyName>RemoteConnectionManager</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Generated by build/icons/build-icons.ps1; do not edit by hand. -->
    <ApplicationIcon>Resources/rcm.ico</ApplicationIcon>
    <!-- WFO0003 is a WinForms analyzer. This is a WPF app, so DPI awareness must stay in app.manifest:
         ApplicationHighDpiMode only applies via WinForms ApplicationConfiguration.Initialize(). -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- WinForms is only here to host the RDP control; keep its namespace out of the global usings. -->
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Markdig" Version="1.6.0" />
    <!-- Website tabs. The Evergreen WebView2 runtime ships with Windows 11. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageReference Include="Devolutions.MsRdpEx" Version="2026.10.26" />
    <!-- Terminals: the Windows Terminal WPF renderer (managed wrapper plus the native
         Microsoft.Terminal.Control.dll under runtimes/win-x64) and a current conpty.dll. -->
    <PackageReference Include="Microsoft.Terminal.Wpf" Version="1.24.260303001" />
    <PackageReference Include="Microsoft.Windows.Console.ConPTY" Version="1.25.260930003" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Resources/rcm.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\RemoteConnectionManager.Core\RemoteConnectionManager.Core.csproj" />
    <ProjectReference Include="..\RemoteConnectionManager.Data.SqlServer\RemoteConnectionManager.Data.SqlServer.csproj" />
    <ProjectReference Include="..\RemoteConnectionManager.Rdp\RemoteConnectionManager.Rdp.csproj" />
    <ProjectReference Include="..\RemoteConnectionManager.KeyVault\RemoteConnectionManager.KeyVault.csproj" />
    <ProjectReference Include="..\RemoteConnectionManager.Plugins\RemoteConnectionManager.Plugins.csproj" />
    <ProjectReference Include="..\RemoteConnectionManager.Plugins.OnePassword\RemoteConnectionManager.Plugins.OnePassword.csproj" />
    <ProjectReference Include="..\RemoteConnectionManager.Plugins.ServerChecks\RemoteConnectionManager.Plugins.ServerChecks.csproj" />
  </ItemGroup>
</Project>
